# Copy to .env and fill in. Never commit .env.
ENVIRONMENT=development

# Database (used by docker compose)
POSTGRES_DB=tradeflow
POSTGRES_USER=tradeflow
POSTGRES_PASSWORD=change-this-db-password

# Auth — generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-this-to-a-long-random-string
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14

# Comma-separated origins allowed to call the API directly (the bundled Nginx proxies /api, so same-origin works by default)
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# First super admin, created by the seed if it does not exist. Leave the password empty to skip.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=

# Load the clearly-labelled SIMULATED demo dataset (true for hackathon demos, false for real deployments)
SEED_DEMO=true

# Optional LLM provider for the market assistant. Empty = deterministic engine only.
# LLM_PROVIDER=openai_compatible | anthropic
LLM_PROVIDER=
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

MAX_UPLOAD_MB=10
AUTH_RATE_LIMIT=20
AUTH_RATE_WINDOW_SECONDS=60

# Optional package mirrors for slow/blocked connections (used at image build time).
# PIP_INDEX_URL=https://pypi.org/simple
# NPM_REGISTRY=https://registry.npmjs.org/
